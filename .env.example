# 用法：cp .env.example .env，再按机器改。.env 不入库（.gitignore），机器相关的地址、主机名都放这里。
# 两类读者：
#   - docker compose（服务端，跑在工作站上）：读「服务端」一节
#   - 本机工具（tools/deploy.sh、skill CLI、probe/）：读「本机工具」一节
# tools/deploy.sh 同步代码时排除 .env，本机与工作站各自维护一份，互不覆盖。

# ── 服务端（docker compose）─────────────────────────────────────────────────

# api 发布在哪个地址。默认只回环，别的机器访问不到。
# 要让 tailnet / 局域网访问，填该机的 IP（例如 Tailscale IP，形如 100.x.y.z）。
BIND_ADDR=127.0.0.1

# 网页的正式入口（例如经 Cloudflare Access 暴露的 https://aladin.example.com）。
# 设置后，从其他 Host 访问页面会 307 到这里；/api/v1 不受影响，仍可在内网直连。
# 本机开发留空。
ALADIN_PUBLIC_URL=

# 未指定尺度时的默认值：general（日常）/ suggestive（暗示）/ explicit（露骨）。
# 每个尺度在各模型下补什么词见 aladin/prompt_defaults.py 的 FAMILIES。
ALADIN_DEFAULT_RATING=explicit

# Postgres 映射到宿主哪个端口，仅供宿主上跑测试/排查。被占用时改。
POSTGRES_HOST_PORT=5433

# 容器以谁的身份写 ./data。
# macOS（Docker Desktop 会把属主映射成宿主用户）：不用设，默认 root 没问题。
# Linux：必须设成宿主用户，否则产物属主是 root，宿主用户连删都删不掉。
# ALADIN_UID=1000
# ALADIN_GID=1000

# 本地开发用的默认口令；postgres 只发布在 127.0.0.1，不对外。
# POSTGRES_PASSWORD=aladin-local

# 可选：Modal 本计费周期的额度（美元）。填了页面顶栏才显示「余额 ≈ 额度 − 已抵扣 credits」；
# Modal 没有查余额的 API，不填就只显示本期开销与 credits 抵扣。
# MODAL_CREDIT_GRANT=30

# 注意：worker 的 Modal 凭据固定取「运行 docker compose 那个用户的 ~/.modal.toml」，
# 挂到容器内 /etc/aladin/modal.toml。所以别用 sudo 跑 compose，否则会去找 /root/.modal.toml。
# 凭据本身永远不写进 .env 或代码。

# ── 本机工具 ──────────────────────────────────────────────────────────────────

# skill CLI（.agents/skills/aladin/scripts/aladin.py）连接的服务地址。
# 例如工作站的 tailnet 地址 http://<主机名>.<tailnet>.ts.net:8765；不填默认 http://127.0.0.1:8765。
ALADIN_URL=

# tools/deploy.sh 的部署目标：SSH 主机名（~/.ssh/config 里的别名即可）与远端 compose 目录。
ALADIN_HOST=
ALADIN_REMOTE_DIR=~/docker/aladin

# probe/ 读取的参考实现 agent-media-lab 的路径；不填默认与本仓库同级的 ../agent-media-lab。
# AGENT_MEDIA_LAB=

# Civitai API key（civitai.com/user/account → API Keys）：python -m aladin loras-sync 下载 LoRA 用。
# 只在本机使用，不上传到 Modal、不写进日志。
CIVITAI_API_KEY=
